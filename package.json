{
  "name": "visiontrack-monorepo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "cd frontend && npm install && npm run dev",
    "build": "cd frontend && npm install && npm run build && rm -rf ../dist && mkdir -p ../dist && cp -r out/* ../dist/",
    "clean": "rm -rf dist frontend/out frontend/.next",
    "lint": "cd frontend && npm run lint || echo 'Lint skipped'",
    "prepare": "husky",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md,css}\""
  },
  "dependencies": {
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "next": "^15.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-beta.8",
    "@types/node": "^22.10.1",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.8",
    "postcss": "^8.4.49",
    "tailwindcss": "^4.0.0-beta.8",
    "typescript": "^5.7.2"
  },
  "lint-staged": {
    "ai_engine/**/*.py": [
      "black --check",
      "isort --check-only",
      "ruff check"
    ],
    "backend/**/*.py": [
      "black --check",
      "isort --check-only",
      "ruff check"
    ],
    "frontend/**/*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
