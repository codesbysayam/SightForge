APP_NAME=SIGHTFORGE
APP_ENV=development
DEBUG=true

SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET

FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
API_PREFIX=/api/v1

# =========================
# COMPUTER VISION
# =========================

CV_DEVICE=auto

PERSON_MODEL=models/yolov8s.pt
POSE_MODEL=models/yolov8s-pose.pt

PERSON_CONFIDENCE=0.35
PERSON_IOU=0.45

POSE_CONFIDENCE=0.35
KEYPOINT_CONFIDENCE=0.25

TRACKING_ENABLED=true
TRACKER_TYPE=bytetrack

TRACK_HIGH_THRESHOLD=0.40
TRACK_LOW_THRESHOLD=0.10
TRACK_NEW_TRACK_THRESHOLD=0.30

TRACK_MAX_AGE=15
TRACK_MIN_HITS=2

INFERENCE_FPS_TARGET=25
MAX_STREAM_FPS=30

# Optional Gemini Server-Side Key for multi-modal scene understanding
GEMINI_API_KEY=
