# SIGHTFORGE Environment Configuration Example
# Public Application Configuration
NEXT_PUBLIC_APP_NAME=SIGHTFORGE
NEXT_PUBLIC_APP_VERSION=2.4.0
NEXT_PUBLIC_DEFAULT_CAMERA_FPS=30

# Computer Vision Edge Engine Configuration
NEXT_PUBLIC_CV_ENGINE=coco-ssd
NEXT_PUBLIC_CV_CONFIDENCE_THRESHOLD=0.35
NEXT_PUBLIC_CV_IOU_THRESHOLD=0.45

# Optional Gemini API Key (Server-side only)
# GEMINI_API_KEY=your_gemini_api_key_here
