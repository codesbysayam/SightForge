# ==============================================================================
# VisionTrack AI - Enterprise Environment Variables Configuration Example
# ==============================================================================

# Core Application Settings
APP_NAME="VisionTrack AI"
APP_ENV="development"
DEBUG=true
SECRET_KEY="visiontrack_super_secret_key_change_before_production_2026"

# Network & Host Setup
FRONTEND_URL="http://localhost:3000"
BACKEND_URL="http://localhost:8000"
API_PREFIX="/api/v1"

# Database Configuration (PostgreSQL Enterprise Pool)
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres123"
POSTGRES_HOST="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="visiontrack_db"
DATABASE_URL="postgresql://postgres:postgres123@localhost:5432/visiontrack_db"

# Database Connection Pool Tuning
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800
DB_POOL_TIMEOUT=30

# JWT & Authentication Setup
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# AI Engine & Computer Vision Settings
YOLO_MODEL_NAME="yolov8n.pt"
YOLO_HALF_PRECISION=false
CV_DEVICE="auto"
CUDA_VISIBLE_DEVICES="0"
INFERENCE_BATCH_SIZE=1
CONFIDENCE_THRESHOLD=0.25
IOU_THRESHOLD=0.45

# Multi-Object Tracking Settings
TRACKER_TYPE="bytetrack"
TRACK_HIGH_THRESH=0.6
TRACK_LOW_THRESH=0.1
NEW_TRACK_THRESH=0.7
TRACK_BUFFER=30
MATCH_THRESH=0.8

# Camera & Streaming Service Setup
MAX_CAMERA_STREAMS=4
STREAM_FRAME_WIDTH=1280
STREAM_FRAME_HEIGHT=720
STREAM_FPS=30
RECONNECT_INTERVAL_SECONDS=5

# Storage Configuration
STORAGE_PROVIDER="local"
STORAGE_BASE_PATH="./storage"
AWS_ACCESS_KEY_ID="dummy"
AWS_SECRET_ACCESS_KEY="dummy"
AWS_STORAGE_BUCKET_NAME="visiontrack-storage"
AWS_S3_REGION_NAME="ap-south-1"
GCS_PROJECT_ID="dummy-project"
GCS_BUCKET_NAME="dummy-bucket"
GCS_CREDENTIALS_JSON="{}"

# Logging & Monitoring
LOG_LEVEL="INFO"
LOG_FORMAT="json"
LOG_TO_FILE=true
LOG_FILE_PATH="./logs/app.log"

# Third-Party API Keys & Services
SENTRY_DSN=""
DATADOG_API_KEY=""

# Analytics & Metrics
ENABLE_PROMETHEUS_METRICS=true
METRICS_PORT=9090
