# Dockerfile.ai: SIGHTFORGE Edge Computer Vision Inference Node
# ==============================================================================

# Use official NVIDIA PyTorch image as standard base for CUDA hardware acceleration
FROM nvcr.io/nvidia/pytorch:23.10-py3 AS runner

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    DEBIAN_FRONTEND=noninteractive

# Install critical system libraries for OpenCV, Video Streaming (GStreamer, FFmpeg)
RUN apt-get update && apt-get install --no-install-recommends -y \
    libgl1-mesa-glx \
    libglib2.0-0 \
    libgstreamer1.0-0 \
    libgstreamer-plugins-base1.0-0 \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    ffmpeg \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy configuration and specifications
COPY requirements.txt .

# Install OpenCV, ultralytics (YOLOv8 framework), and computer vision accessories
RUN pip install --no-cache-dir ultralytics opencv-python-headless numpy filterpy lap

# Copy local AI Engine files
COPY ./ai_engine /app/ai_engine

# Pre-create folders for model weights and dynamic pipeline frame buffers
RUN mkdir -p /app/ai_engine/weights /app/data/storage && \
    chmod -R 755 /app/ai_engine/weights /app/data/storage

# Expose internal metrics port if Prometheus client is used in the pipeline
EXPOSE 9090

# Run computer vision coordinator
CMD ["python", "ai_engine/main.py"]
